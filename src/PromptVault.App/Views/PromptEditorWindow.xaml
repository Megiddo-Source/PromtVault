<Window x:Class="PromptVault.App.Views.PromptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Editor de prompt"
        Width="900"
        Height="760"
        MinWidth="720"
        MinHeight="630"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource TitleBarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" BorderBrush="#2D6553" BorderThickness="1">
                        <TextBlock Text="P" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Editor de prompt" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" ToolTip="Minimizar" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" ToolTip="Maximizar" Click="MaximizeButton_Click" Style="{StaticResource TitleBarButtonStyle}" />
                    <Button Content="&#xE8BB;" ToolTip="Cerrar" Click="CloseTitleBarButton_Click" Style="{StaticResource CloseTitleBarButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Construye un prompt reutilizable" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Añade contexto, organización y variables para encontrarlo y usarlo rápidamente."
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12.5" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="TÍTULO" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 ToolTip="Un nombre breve y fácil de localizar" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORÍA" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7" />
                            <ComboBox IsEditable="True"
                                      ItemsSource="{Binding CategorySuggestions}"
                                      Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MODELO" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7" />
                            <ComboBox IsEditable="True"
                                      ItemsSource="{Binding ModelSuggestions}"
                                      Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ETIQUETAS" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Separadas por comas"
                                     TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,7" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Explica brevemente para qué sirve" />
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONTENIDO" Style="{StaticResource SectionTitleStyle}" />
                            <Border Grid.Column="1" Padding="8,3" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" BorderBrush="#2D6553" BorderThickness="1">
                                <TextBlock Text="{}Variables: {{nombre_variable}}" Foreground="{StaticResource AccentBrush}" FontSize="10.5" />
                            </Border>
                        </Grid>
                        <TextBox Grid.Row="2"
                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Style="{StaticResource CodeTextBoxStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Content="Marcar como favorito" IsChecked="{Binding IsFavorite}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Click="Cancel_Click" MinWidth="96" Margin="0,0,9,0" Style="{StaticResource GhostButtonStyle}" />
                    <Button Content="Guardar prompt" Click="Save_Click" MinWidth="128" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
