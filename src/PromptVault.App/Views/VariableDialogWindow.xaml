<Window x:Class="PromptVault.App.Views.VariableDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Completar variables"
        Width="570"
        Height="520"
        MinWidth="460"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource TitleBarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" BorderBrush="#2D6553" BorderThickness="1">
                        <TextBlock Text="{}{{ }}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Completar variables" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#xE8BB;"
                        ToolTip="Cerrar"
                        Click="CloseTitleBarButton_Click"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,20,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Prepara el prompt" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Completa los valores que se insertarán antes de copiar el contenido."
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12.5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Values}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Name}" Margin="0,0,0,7" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancel_Click" MinWidth="96" Margin="0,0,9,0" Style="{StaticResource GhostButtonStyle}" />
                <Button Click="Accept_Click" MinWidth="155" Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#07110D" />
                        <TextBlock Text="Generar y copiar" Margin="8,0,0,0" Foreground="#07110D" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
